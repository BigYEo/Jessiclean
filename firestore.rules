rules_version = '2';

// Règles de sécurité Jessiclean
// Courriel de l'administratrice : le même que dans firebase-config.js (en minuscules).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email()    { return request.auth.token.email.lower(); }
    function isAdmin()  { return signedIn() && email() in ['jaykaa92@icloud.com']; }
    // Une employée a accès si une fiche « employees » porte son courriel comme identifiant
    function isStaff()  { return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/employees/$(email()))); }

    // Avis : tout le monde peut lire et publier ; seule l'admin supprime
    match /reviews/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'text', 'stars', 'ts'])
        && request.resource.data.keys().hasAll(['name', 'text', 'stars', 'ts'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.ts is int;
      allow update, delete: if isAdmin();
    }

    // Employées et horaire : visibles par l'équipe connectée, modifiables par l'admin
    match /employees/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /shifts/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Fiches clients : admin seulement
    match /clients/{id} {
      allow read, write: if isAdmin();
    }

    // Infos pratiques des clients (entrée, aspirateur, produits…) : visibles par l'équipe
    match /clientInfo/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Pièces jointes (stockées en texte, max ≈ 900 000 caractères par fichier)
    function okFile() {
      return request.resource.data.data is string && request.resource.data.data.size() <= 900000
        && request.resource.data.name is string && request.resource.data.name.size() <= 200;
    }
    match /shiftFiles/{id} {
      allow read: if isStaff();
      allow create, update: if isAdmin() && okFile();
      allow delete: if isAdmin();
    }
    match /clientFiles/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && okFile();
    }

    // Demandes de soumission : tout le monde peut en envoyer ; seule l'admin les lit
    match /requests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'service', 'city', 'message', 'ts', 'done'])
        && request.resource.data.keys().hasAll(['name', 'phone', 'email', 'service', 'city', 'message', 'ts', 'done'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && (request.resource.data.phone.size() > 0 || request.resource.data.email.size() > 0)
        && request.resource.data['service'] is string && request.resource.data['service'].size() <= 60
        && request.resource.data.city is string && request.resource.data.city.size() <= 120
        && request.resource.data.message is string && request.resource.data.message.size() <= 1500
        && request.resource.data.ts is int && request.resource.data.done == false;
      allow read, update, delete: if isAdmin();
    }

    // Horaire client : lisible seulement avec le code exact (pas de liste possible)
    match /visits/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }
  }
}
