rules_version = '2';

// Règles de sécurité Jessiclean
// ⚠ Remplacez admin@exemple.com par votre courriel (en minuscules),
//   le même que dans firebase-config.js.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email()    { return request.auth.token.email.lower(); }
    function isAdmin()  { return signedIn() && email() in ['admin@exemple.com']; }
    // Une employée a accès si une fiche « employees » porte son courriel comme identifiant
    function isStaff()  { return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/employees/$(email()))); }

    // Avis : tout le monde peut lire et publier ; seule l'admin supprime
    match /reviews/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'text', 'stars', 'ts'])
        && request.resource.data.keys().hasAll(['name', 'text', 'stars', 'ts'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.ts is int;
      allow update, delete: if isAdmin();
    }

    // Employées et horaire : visibles par l'équipe connectée, modifiables par l'admin
    match /employees/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /shifts/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Fiches clients : admin seulement
    match /clients/{id} {
      allow read, write: if isAdmin();
    }

    // Horaire client : lisible seulement avec le code exact (pas de liste possible)
    match /visits/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }
  }
}
