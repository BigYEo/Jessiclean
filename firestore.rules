rules_version = '2';

// Règles de sécurité Jessiclean
// Courriel de l'administratrice : le même que dans firebase-config.js (en minuscules).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email()    { return request.auth.token.email.lower(); }
    function isAdmin()  { return signedIn() && email() in ['jaykaa92@icloud.com', 'admin@jessiclean.ca']; }
    // Une employée a accès si une fiche « employees » porte son courriel comme identifiant
    function isStaff()  { return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/employees/$(email()))); }

    // Avis : tout le monde peut lire et publier ; seule l'admin supprime
    match /reviews/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'text', 'stars', 'ts'])
        && request.resource.data.keys().hasAll(['name', 'text', 'stars', 'ts'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.ts is int;
      allow update, delete: if isAdmin();
    }

    // Employées et horaire : visibles par l'équipe connectée, modifiables par l'admin
    match /employees/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /shifts/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Fiches clients : admin seulement
    match /clients/{id} {
      allow read, write: if isAdmin();
    }

    // Infos pratiques des clients (entrée, aspirateur, produits…) : visibles par l'équipe
    match /clientInfo/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Pièces jointes (stockées en texte, max ≈ 900 000 caractères par fichier)
    function okStr(k, n) { return request.resource.data[k] is string && request.resource.data[k].size() <= n; }
    function okFile() {
      return request.resource.data.data is string && request.resource.data.data.size() <= 900000
        && request.resource.data.name is string && request.resource.data.name.size() <= 200;
    }
    match /shiftFiles/{id} {
      allow read: if isStaff();
      allow create, update: if isAdmin() && okFile();
      allow delete: if isAdmin();
    }
    match /clientFiles/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && okFile();
    }

    // Demandes de soumission : tout le monde peut en envoyer ; seule l'admin les lit
    match /requests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'addr', 'service', 'habitat', 'rooms', 'basement', 'pets', 'days', 'hours', 'message', 'ts', 'done'])
        && request.resource.data.keys().hasAll(['name', 'phone', 'email', 'addr', 'service', 'habitat', 'rooms', 'basement', 'pets', 'days', 'hours', 'message', 'ts', 'done'])
        && okStr('name', 80) && request.resource.data['name'].size() > 0
        && okStr('phone', 30) && okStr('email', 120)
        && (request.resource.data['phone'].size() > 0 || request.resource.data['email'].size() > 0)
        && okStr('addr', 200) && okStr('service', 60) && okStr('habitat', 60) && okStr('rooms', 80)
        && okStr('basement', 40) && okStr('pets', 120) && okStr('hours', 80) && okStr('message', 1500)
        && request.resource.data['days'] is list && request.resource.data['days'].size() <= 7
        && request.resource.data['ts'] is int && request.resource.data['done'] == false;
      allow read, update, delete: if isAdmin();
    }

    // Horaire client : lisible seulement avec le code exact (pas de liste possible)
    // Demandes envoyées depuis l'espace client (déplacement, mise à jour de fiche)
    match /clientInbox/{id} {
      allow create: if request.resource.data.keys().hasOnly(['code', 'name', 'kind', 'visit', 'message', 'contact', 'changes', 'ts', 'done'])
        && okStr('code', 20) && exists(/databases/$(database)/documents/visits/$(request.resource.data['code']))
        && request.resource.data['kind'] in ['move', 'fiche']
        && okStr('name', 120) && okStr('visit', 40) && okStr('message', 1500) && okStr('contact', 120)
        && request.resource.data['changes'] is map && request.resource.data['changes'].size() <= 20
        && request.resource.data['ts'] is int && request.resource.data['done'] == false;
      allow read, update, delete: if isAdmin();
    }
    // Confirmations de visites par le client (une fiche par code)
    match /confirm/{code} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create, update: if exists(/databases/$(database)/documents/visits/$(code))
        && request.resource.data.keys().hasOnly(['keys', 'ts'])
        && request.resource.data['keys'] is list && request.resource.data['keys'].size() <= 100
        && request.resource.data['ts'] is int;
    }
    // Factures : admin seulement (le client les voit via son horaire)
    match /invoices/{id} {
      allow read, write: if isAdmin();
    }

    // Courriels aux clients : écrits par l'admin, envoyés par le programme automatique
    match /mail/{id} {
      allow read, write: if isAdmin();
    }
    match /system/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin() && id == 'github';
    }

    match /visits/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }
  }
}
